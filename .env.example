# Mundostra Demo — Environment Variables

# Application
APP_ENV=development
MOCK_LLM=true

# AWS Bedrock (Claude Opus 4.5 + Claude Haiku)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Vertex AI (Gemini 3 Flash)
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# OpenAI (GPT-5.2)
OPENAI_API_KEY=

# Slack Integration
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_ENABLED=false
SLACK_DEFAULT_CHANNEL=C0XXXXXXX

# Server
HOST=0.0.0.0
PORT=8000
